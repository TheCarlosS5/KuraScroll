# KuraScroll Server Configuration
PORT=4000
HOST=127.0.0.1

# Storage Volume (Mechanical HDD or local directory)
STORAGE_ROOT=./data/storage

# Shared Proxy Token (Machine-to-machine between HTTPS Reverse Proxy and Backend)
# DO NOT EXPOSE TO BROWSER JAVASCRIPT
API_TOKEN=

# CORS & Allowed Origins for Web and Cookie Protection
KURA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Quota per User Account (Default: 10 GiB = 10737418240 bytes)
USER_STORAGE_QUOTA_BYTES=10737418240

# Public URL used in email action links
PUBLIC_BASE_URL=http://localhost:5173

# Outgoing SMTP Configuration for User Registration & Password Reset
# In development: leave SMTP_HOST empty or set to 'console' to log verification links to stdout
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KuraScroll" <noreply@kurascroll.local>
SMTP_SECURE=false

# Image Pipeline Defaults
MAX_IMAGE_WIDTH=1440
WEBP_QUALITY=82
