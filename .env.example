# ==============================================================================
# KuraScroll - Platform Configuration & Deployment Settings
# ==============================================================================

# Server Network Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
PUBLIC_PLATFORM_MODE=true
TRUST_PROXY=true

# Storage Location
# Single-container / VPS setup: Ensure this points to a persistent volume (e.g., /app/data/storage or ./data/storage)
STORAGE_ROOT=./data/storage
INCOMING_DIR=./data/storage/incoming

# Image Transcoding Engine Settings
MAX_IMAGE_WIDTH=1440
WEBP_QUALITY=82

# The public browser platform uses account sessions; do not set API_TOKEN here.
# For private machine-to-machine use, configure API_TOKEN in a separate deployment profile.

# Session & Security Settings
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Production requires HTTPS at the reverse proxy and Secure session cookies.
COOKIE_SECURE=true

# Allowed CORS Origins (comma separated)
KURA_CORS_ORIGINS=https://manga.example.com

# Optional Email / SMTP Verification (Leave SMTP_HOST blank to run in offline/self-hosted mode without email)
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KuraScroll <no-reply@kura-scroll.local>

# Storage & Upload Quotas
MAX_FILE_SIZE_MB=25
MAX_PAGES_PER_CHAPTER=250
USER_QUOTA_GB=5
