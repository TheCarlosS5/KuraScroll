{
  "name": "kura-scroll",
  "version": "1.0.0",
  "description": "High-performance Manga, Manhwa, and Manhua reader platform - Sister to KuraStream",
  "main": "dist/backend/server.js",
  "scripts": {
    "dev": "tsx watch src/backend/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "tsc && npm --prefix frontend run build",
    "test": "vitest run",
    "test:frontend": "npm --prefix frontend run test",
    "test:all": "vitest run && npm --prefix frontend run test",
    "test:sla": "tsx scripts/benchmark-sla.ts",
    "ingest": "tsx src/backend/cli/ingest-cli.ts",
    "watch:incoming": "tsx src/backend/daemon/folder-watcher.ts",
    "purge:data": "tsx scripts/purge-test-data.ts",
    "ingest:pdf": "tsx scripts/ingest-pdf-mangas.ts"
  },
  "keywords": [
    "manga",
    "manhwa",
    "manhua",
    "webtoon",
    "reader",
    "kura-stream"
  ],
  "author": "Carlos & Antigravity Orchestrator",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "10.1.7",
    "@fastify/static": "^10.1.10",
    "adm-zip": "^0.6.1",
    "fastify": "^5.2.1",
    "nodemailer": "^10.3.1",
    "p-limit": "^6.2.0",
    "sharp": "^0.35.5",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
